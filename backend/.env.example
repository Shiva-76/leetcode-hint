# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ── LLM Provider (stub for Phase 2, swap in Phase 4) ─────────────────────────
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# ── Database ──────────────────────────────────────────────────────────────────
# Dev: SQLite (zero setup)  |  Prod: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./coach.db

# ── Qdrant Vector DB ──────────────────────────────────────────────────────────
# Leave empty for in-memory dev mode  |  Prod: http://localhost:6333
QDRANT_URL=
